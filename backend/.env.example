# Salin ke backend/.env — JANGAN commit .env asli.
# Database: kosongkan untuk SQLite lokal (syncnol_local.db).
# Contoh Postgres (Supabase/Coolify): postgresql://user:pass@host:5432/db
DATABASE_URL=
# Gemini API key (https://aistudio.google.com/apikey) — wajib untuk
# /api/chat dan /api/nudge; tanpa ini endpoint AI mengembalikan error jelas.
GEMINI_API_KEY=
# CORS, pisahkan koma. Default: * (terbuka, seperti sebelumnya).
CORS_ORIGINS=*
